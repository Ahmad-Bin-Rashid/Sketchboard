# ===========================================
# Clerk Authentication
# Get these from https://dashboard.clerk.com
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk redirect URLs (Clerk v5+)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ===========================================
# Database (Neon PostgreSQL)
# Get from https://console.neon.tech
# ===========================================
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/whiteboard?sslmode=require

# ===========================================
# PartyKit (Real-time collaboration)
# ===========================================
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# ===========================================
# File Upload (Uploadthing)
# Get from https://uploadthing.com/dashboard
# ===========================================
UPLOADTHING_TOKEN=


# ===========================================
# App
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
