# ===========================================
# Clerk Authentication
# Get these from https://dashboard.clerk.com
# ===========================================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=...
CLERK_SECRET_KEY=...

# Clerk redirect URLs (Clerk v5+)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Clerk webhook signing secret
# Get from: Clerk Dashboard → Webhooks → your endpoint → Signing Secret
CLERK_WEBHOOK_SECRET=...

# ===========================================
# Database (Neon PostgreSQL)
# Get from https://console.neon.tech
# ===========================================
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/sketchboard?sslmode=require

# ===========================================
# Liveblocks (Real-time collaboration)
# Get from: liveblocks.io/dashboard → your project → API Keys
# Free tier: 50 MAU, unlimited rooms
# ===========================================
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_dev_...
LIVEBLOCKS_SECRET_KEY=sk_dev_...

# ===========================================
# File Upload (Uploadthing)
# Get from https://uploadthing.com/dashboard
# ===========================================
UPLOADTHING_TOKEN=...

# ===========================================
# App — set to your production domain on Vercel
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

